rules_version = '2';
// ★ 이 Firebase 프로젝트(cloze-a8e6c)는 이제 어떤 앱도 쓰지 않아요 (옛 기록 보관용).
//   MY Cloze·단어숲·AI 영작문 튜터를 2026-11 Supabase 로 옮겼어요. 옛 기록은 여기 그대로 남아 있지만 모두 "읽기 전용"이에요
//   (cloze/migrate.html 이 읽어서 옮겨요. 옛 앱이 남아 있는 기기에서 새로 쓰려 해도 막혀요).
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 "통째로" 붙여 넣고 [게시]를 누르세요.
// (cloze/firestore.rules 와 danuhsup/firestore.rules 는 같은 내용입니다.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isTeacher() {
      return signedIn() && myEmail() in ['tfellow@gmail.com', 'tfellow@smy.ms.kr', 'engwords@smy.ms.kr', 'hist1026@gmail.com'];
    }
    function isSchool() {
      return signedIn() && (myEmail().matches('.*@smy[.]ms[.]kr') || isTeacher());
    }

    // ---------- MY Cloze (옛 기록, 읽기 전용) ----------
    match /users/{uid} {
      allow read: if isSchool() && (request.auth.uid == uid || isTeacher());
      allow write: if false;
    }

    match /tests/{testId} {
      allow read: if isSchool();
      allow write: if false;
    }

    match /submissions/{subId} {
      allow read: if isSchool() && (resource.data.uid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /board/{subId} {
      allow read: if isSchool();
      allow write: if false;
    }

    match /assignments/{aid} {
      allow read: if isSchool();
      allow write: if false;
    }

    // ===================== 단어숲 (danuhsup, 옛 기록) =====================
    function vocabTeacher() {
      return isTeacher() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isMe(uid) { return isSchool() && request.auth.uid == uid; }

    // 옛 기록 (읽기 전용): 학생 정보·암기 상태·랭킹·단어장
    match /vocab_users/{uid} {
      allow read: if isMe(uid) || vocabTeacher();
      allow write: if false;
      match /progress/{bookId} {
        allow read: if isMe(uid) || vocabTeacher();
        allow write: if false;
      }
    }
    match /vocab_board/{uid} {
      allow read: if isSchool();
      allow write: if false;
    }
    // vocab_books/_settings 에는 영작문 튜터의 옛 과제 목록(writing1_ 칸)도 들어 있어요
    match /vocab_books/{id} {
      allow read: if isSchool();
      allow write: if false;
    }
    // vocab_results: 단어숲 옛 결과 + 영작문 옛 제출
    match /vocab_results/{id} {
      allow read: if isSchool() && (resource.data.uid == request.auth.uid || vocabTeacher());
      allow write: if false;
    }

    // ===================== AI 영작문 튜터 (writing1, 옛 기록) =====================
    // 명렬표와 Gemini 키: 교사만 읽기 (학생은 볼 수 없어요)
    match /writing1_private/{id} {
      allow read: if vocabTeacher();
      allow write: if false;
    }
    // 학생 한 명의 학번·이름: 본인과 교사만 읽기
    match /writing1_students/{email} {
      allow read: if vocabTeacher() || (isSchool() && myEmail() == email);
      allow write: if false;
    }
  }
}
