{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MY Arcade result submission",
  "type": "object",
  "required": ["format", "sessions"],
  "properties": {
    "format": {"const": "my-arcade-results-v1"},
    "sessions": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "mode", "grade", "unit", "studentNumber", "studentName", "completedAt", "elapsedMs", "attempts"],
        "properties": {
          "id": {"type": "string", "maxLength": 100},
          "userId": {"type": ["string", "null"]},
          "studentNumber": {"type": "string", "maxLength": 20},
          "studentName": {"type": "string", "maxLength": 30},
          "mode": {"enum": ["spelling", "sentence", "match", "meaning", "reverse", "definition", "cloze", "memory", "listening", "anagram", "truefalse", "crypto"]},
          "grade": {"enum": [1, 2, 3]},
          "unit": {"type": "string"},
          "completedAt": {"type": "string", "format": "date-time"},
          "elapsedMs": {"type": "number", "minimum": 0},
          "bankId": {"type": "string"},
          "reviewSession": {"type": "boolean"},
          "attempts": {
            "type": "array", "minItems": 1, "maxItems": 1000,
            "items": {
              "type": "object",
              "required": ["itemId", "word", "correct", "input", "expected", "elapsedMs"],
              "properties": {
                "itemId": {"type": "string"}, "word": {"type": "string"},
                "correct": {"type": "boolean"}, "input": {"type": "string"},
                "expected": {"type": "string"}, "hintUsed": {"type": "boolean"},
                "phase": {"enum": ["initial", "retry", "review"]},
                "elapsedMs": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
